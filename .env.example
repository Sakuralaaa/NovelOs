# 访问端口：浏览器打开 http://服务器IP:APP_PORT 。端口被占用时改这里。
APP_PORT=8080

# API Key 加密主密钥（随机长字符串）。deploy.sh 会自动生成。
# 注意：设置后不要随意更改，否则已保存的模型渠道 Key 无法解密，需要重新填写。
NOVELOS_SECRET=

# 登录密码（至少 8 位）。留空时首次启动自动生成，见 ./data/initial_password.txt；
# 也可以登录后在「设置 → 账户安全」里修改。填写后以这里为准，页面上不能再改。
NOVELOS_PASSWORD=

# 时区
TZ=Asia/Shanghai
